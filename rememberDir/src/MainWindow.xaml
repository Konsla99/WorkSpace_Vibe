<Window x:Class="rememberDir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rememberDir"
        mc:Ignorable="d"
        Title="rememberDir" Height="250" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F3F3F3">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="rememberDir" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333333"/>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <UniformGrid Columns="2" Margin="0,0,0,10">
                <Button Click="OnSaveClick" Height="70" Background="#0078D4" Foreground="White" BorderThickness="0" Margin="0,0,5,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel>
                        <TextBlock Text="현재 dir" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="기록하기" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Click="OnRestoreClick" Height="70" Background="#2B88D8" Foreground="White" BorderThickness="0" Margin="5,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel>
                        <TextBlock Text="마지막 dir" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="위치 열기" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Text="⚠️ 복원 중에는 키보드/마우스 조작을 멈춰주세요." 
                       HorizontalAlignment="Center" Foreground="#D83B01" FontSize="11" FontWeight="SemiBold" 
                       Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="준비됨" HorizontalAlignment="Center" Foreground="#666666" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
</Window>
